<!-- Icon pack template: the companion app fills res/drawable-nodpi/fi_NNN.png and
     assets/appfilter.xml on the phone and signs the result. The launcher entry is needed:
     Flyme's icon pack picker takes the pack's preview from LauncherApps.getActivityList(). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="ru.neoncatrc.flymeicons.pack">
    <application android:label="@string/pack_name" android:icon="@drawable/ic" android:allowBackup="false">
        <activity android:name=".Main" android:exported="true" android:label="@string/pack_name"
            android:theme="@android:style/Theme.NoDisplay">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <intent-filter>
                <action android:name="org.adw.launcher.THEMES"/>
                <category android:name="android.intent.category.DEFAULT"/>
            </intent-filter>
            <intent-filter>
                <action android:name="com.gau.go.launcherex.theme"/>
                <category android:name="android.intent.category.DEFAULT"/>
            </intent-filter>
        </activity>
    </application>
</manifest>
