<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:background="@drawable/immersive_item_bkg_alone" android:orientation="horizontal"
    android:paddingStart="32dp" android:paddingEnd="32dp" android:paddingTop="24dp" android:paddingBottom="20dp">
    <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
        android:gravity="center_horizontal" android:orientation="vertical">
        <ImageView android:id="@+id/fi_prev_now" android:layout_width="64dp" android:layout_height="64dp" android:scaleType="fitCenter"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="10dp"
            android:text="@string/fi_preview_now" android:textColor="?colorOnSurfaceVariant" style="@style/TextAppearance.Flyme.Body.Mini"/>
    </LinearLayout>
    <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
        android:gravity="center_horizontal" android:orientation="vertical">
        <ImageView android:id="@+id/fi_prev_day" android:layout_width="64dp" android:layout_height="64dp" android:scaleType="fitCenter"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="10dp"
            android:text="@string/fi_preview_day" android:textColor="?colorOnSurfaceVariant" style="@style/TextAppearance.Flyme.Body.Mini"/>
    </LinearLayout>
    <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
        android:gravity="center_horizontal" android:orientation="vertical">
        <ImageView android:id="@+id/fi_prev_night" android:layout_width="64dp" android:layout_height="64dp" android:scaleType="fitCenter"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="10dp"
            android:text="@string/fi_preview_night" android:textColor="?colorOnSurfaceVariant" style="@style/TextAppearance.Flyme.Body.Mini"/>
    </LinearLayout>
</LinearLayout>
